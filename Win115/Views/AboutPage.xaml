<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Win115.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Win115.Views"
    xmlns:m="using:Win115.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Win115.ViewModels"
    Margin="15,15,15,15"
    d:DataContext="{d:DesignInstance vm:AboutViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="CurrentVersionText"
            FontSize="16"
            FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="CheckUpdateButton"
                Height="32"
                Click="CheckUpdate_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE895;" />
                    <TextBlock Text="检查更新" />
                </StackPanel>
            </Button>
            <Button Height="32" Click="OpenMicrosoftStore_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE719;" />
                    <TextBlock Text="前往 Microsoft Store 更新" />
                </StackPanel>
            </Button>
            <Button
                Width="40"
                Height="32"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Click="OpenGitHub_Click"
                ToolTipService.ToolTip="打开 GitHub 项目主页">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
            </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <controls:MarkdownTextBlock
                x:Name="md"
                Config="{x:Bind viewModel.MdConfig, Mode=OneTime}"
                Text="{x:Bind viewModel.AboutMdText, Mode=OneWay}"
                UseAutoLinks="True"
                UseEmphasisExtras="True"
                UseListExtras="True"
                UsePipeTables="True"
                UseTaskLists="True" />
        </ScrollViewer>
    </Grid>
</Page>
