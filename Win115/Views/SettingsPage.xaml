<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Win115.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:cvt="using:Win115.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Win115.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Win115.ViewModels"
    Margin="10,10,10,10"
    mc:Ignorable="d">
    <Page.Resources>
        <animations:ImplicitAnimationSet x:Name="ShowTransitions">
            <animations:OffsetAnimation
                EasingMode="EaseOut"
                From="0,24,0"
                To="0"
                Duration="0:0:0.4" />
            <animations:OpacityAnimation
                EasingMode="EaseOut"
                From="0"
                To="1"
                Duration="0:0:0.2" />
        </animations:ImplicitAnimationSet>
        <animations:ImplicitAnimationSet x:Name="HideTransitions">
            <animations:OffsetAnimation
                EasingMode="EaseOut"
                From="0"
                To="0,24,0"
                Duration="0:0:0.3" />
            <animations:OpacityAnimation
                EasingMode="EaseOut"
                From="1"
                To="0"
                Duration="0:0:0.2" />
        </animations:ImplicitAnimationSet>

    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:Segmented
            x:Name="segmentedControl"
            HorizontalAlignment="Center"
            SelectedIndex="0"
            SelectionMode="Single">
            <controls:SegmentedItem
                MinWidth="180"
                Content="API 设置"
                Tag="api" />
            <!--<controls:SegmentedItem
                MinWidth="180"
                Content="常规设置"
                Tag="system" />
            <controls:SegmentedItem
                MinWidth="180"
                Content="视频播放器设置"
                Tag="player" />
            <controls:SegmentedItem
                MinWidth="180"
                Content="云下载设置"
                Tag="cloudDownload" />-->
            <controls:SegmentedItem
                MinWidth="180"
                Content="下载设置"
                Tag="download" />
            <controls:SegmentedItem
                MinWidth="180"
                Content="上传设置"
                Tag="upload" />
        </controls:Segmented>

        <controls:SwitchPresenter
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Value="{Binding SelectedItem.Tag, ElementName=segmentedControl}">
            <controls:Case Value="api">
                <ScrollViewer
                    Padding="16,0"
                    HorizontalContentAlignment="Stretch"
                    animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                    animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="8">
                        <controls:SettingsCard
                            Description="限制 115 API 每秒发出的请求数；设为 0 时不限制"
                            Header="每秒请求数"
                            HeaderIcon="{ui:FontIcon Glyph='&#xE9D9;'}">
                            <NumberBox
                                Width="120"
                                Maximum="20"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind viewModel.System.ApiRateLimit, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <TextBlock
                            Margin="4,4,4,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="批量操作遇到限流时会自动指数退避并重试，等待时间包含随机抖动。"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Command="{x:Bind viewModel.SaveApiSettingsCommand}"
                            Content="保存设置"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:Case>
            <controls:Case Value="system">
                <ScrollViewer animations:Implicit.HideAnimations="{StaticResource HideTransitions}" animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}">
                    <TextBlock VerticalAlignment="Center" Text="This is the Download panel" />
                </ScrollViewer>
            </controls:Case>
            <controls:Case Value="download">
                <ScrollViewer
                    x:Name="downloadSettingsScrollViewer"
                    Padding="16,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                    animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="8">
                        <controls:SettingsCard
                            Description="新建下载任务默认保存到此目录"
                            Header="默认下载路径"
                            HeaderIcon="{ui:FontIcon Glyph='&#xEB95;'}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox
                                    MinWidth="280"
                                    MaxWidth="520"
                                    IsReadOnly="True"
                                    Text="{x:Bind viewModel.System.DownloadDirPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Command="{x:Bind viewModel.SelectDownloadDirCommand}">
                                    <FontIcon Glyph="&#xEDA2;" ToolTipService.ToolTip="下载默认路径" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="同时运行的下载任务数量，较高数值可能触发 CDN 限流"
                            Header="同时下载任务数"
                            HeaderIcon="{ui:FontIcon Glyph='&#xE8EF;'}">
                            <NumberBox
                                Width="120"
                                Maximum="5"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind viewModel.System.DownloadConcurrentTasks, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="单个大文件使用的连接数；修改后仅影响新任务"
                            Header="单文件分片数"
                            HeaderIcon="{ui:FontIcon Glyph='&#xE943;'}">
                            <NumberBox
                                Width="120"
                                Maximum="8"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind viewModel.System.DownloadSegmentCount, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="所有下载任务共享的速度上限；0 表示不限速"
                            Header="全局速度限制"
                            HeaderIcon="{ui:FontIcon Glyph='&#xE9D9;'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    Width="150"
                                    Maximum="1048576"
                                    Minimum="0"
                                    SmallChange="512"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind viewModel.System.DownloadSpeedLimitKbps, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="KB/s" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Command="{x:Bind viewModel.SaveDownloadSettingsCommand}"
                            Content="保存设置"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:Case>
            <controls:Case Value="upload">
                <ScrollViewer
                    Padding="16,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    animations:Implicit.HideAnimations="{StaticResource HideTransitions}"
                    animations:Implicit.ShowAnimations="{StaticResource ShowTransitions}"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Stretch" Spacing="8">
                        <controls:SettingsCard
                            Description="上传失败后自动重试的次数，0 表示不自动重试"
                            Header="最大重试次数"
                            HeaderIcon="{ui:FontIcon Glyph='&#xE777;'}">
                            <NumberBox
                                Width="120"
                                Maximum="10"
                                Minimum="0"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind viewModel.System.UploadMaxRetry, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="同时运行的上传任务数，较高数值会占用更多网络和系统资源"
                            Header="并行任务数"
                            HeaderIcon="{ui:FontIcon Glyph='&#xE8EF;'}">
                            <NumberBox
                                Width="120"
                                Maximum="10"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind viewModel.System.UploadConcurrentTasks, Mode=TwoWay}" />
                        </controls:SettingsCard>
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Command="{x:Bind viewModel.SaveUploadSettingsCommand}"
                            Content="保存设置"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </controls:Case>
        </controls:SwitchPresenter>
    </Grid>
</Page>
